<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.FinSell" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores primarios -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/colorOnPrimaryContainer</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorSecondary">@color/secondary</item>
        <!-- Errores -->
        <!-- ⚠️ IMPORTANTE: Re-declarar los atributos personalizados -->
        <item name="colorBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorError">@color/colorError</item>
        <item name="colorOnBackground">@color/colorOnBackground</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorOnError">@color/colorOnError</item>

        <!-- Fuentes -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>

        <!-- Ventana -->
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:navigationBarColor">@color/colorSurface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimation.FinSell.Rapid</item>

        <!-- Estilos de widgets -->
        <item name="materialButtonStyle">@style/Widget.FinSell.Button</item>
        <item name="bottomNavigationStyle">@style/Widget.FinSell.BottomNavigation</item>
    </style>

    <style name="Theme.FinSell" parent="Base.Theme.FinSell" />
    <style name="Theme.CafePos" parent="Base.Theme.FinSell" />

    <style name="WindowAnimation.FinSell.Rapid" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/activity_fade_in_rapid</item>
        <item name="android:activityOpenExitAnimation">@anim/activity_fade_out_rapid</item>
        <item name="android:activityCloseEnterAnimation">@anim/activity_fade_in_rapid</item>
        <item name="android:activityCloseExitAnimation">@anim/activity_fade_out_rapid</item>
    </style>
</resources>
