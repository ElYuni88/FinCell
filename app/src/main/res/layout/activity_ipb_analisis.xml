<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/pos_green"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Análisis del período"
        app:titleTextColor="@android:color/white" />

    <TextView
        android:id="@+id/txtRango"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_variant"
        android:padding="10dp"
        android:textAppearance="@style/TextAppearance.FinSell.Secondary"
        android:textStyle="bold" />

    <!-- Header de columnas con IDs para poder sombrearlos en modo matrix -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/headerProducto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:background="@color/surface"
            android:padding="4dp"
            android:text="Producto / Precio"
            android:textAppearance="@style/TextAppearance.FinSell.Label"
            android:textColor="@color/pos_green"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/headerEntrada"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/surface"
            android:gravity="center"
            android:padding="4dp"
            android:text="Entrada"
            android:textAppearance="@style/TextAppearance.FinSell.Label"
            android:textColor="@color/pos_green"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/headerStockIni"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/surface"
            android:gravity="center"
            android:padding="4dp"
            android:text="Stock Ini"
            android:textAppearance="@style/TextAppearance.FinSell.Label"
            android:textColor="@color/pos_green"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/headerVendidos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:background="@color/surface"
            android:gravity="center"
            android:padding="4dp"
            android:text="Vendidos"
            android:textAppearance="@style/TextAppearance.FinSell.Label"
            android:textColor="@color/pos_green"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/headerStockFin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/surface"
            android:gravity="center"
            android:padding="4dp"
            android:text="Stock Fin"
            android:textAppearance="@style/TextAppearance.FinSell.Label"
            android:textColor="@color/pos_green"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/headerSubtotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:background="@color/surface"
            android:gravity="end"
            android:padding="4dp"
            android:text="Subtotal"
            android:textAppearance="@style/TextAppearance.FinSell.Label"
            android:textColor="@color/pos_green"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/pos_green" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAnalisis"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/background"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/txtVacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="No hay productos para analizar"
        android:textAppearance="@style/TextAppearance.FinSell.Secondary"
        android:visibility="gone" />

    <!-- Botón para ver gastos desglosados -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerGastos"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:text="💸 Ver gastos desglosados"
        android:textColor="@color/colorError"
        app:strokeColor="@color/colorError" />

    <!-- Footer con totales: ventas, gastos, NETO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total ventas"
                android:textAppearance="@style/TextAppearance.FinSell.Body" />

            <TextView
                android:id="@+id/txtTotalVentas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="$0.00"
                android:textAppearance="@style/TextAppearance.FinSell.Body"
                android:textStyle="bold"
                android:textColor="@color/pos_green" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total gastos"
                android:textAppearance="@style/TextAppearance.FinSell.Body" />

            <TextView
                android:id="@+id/txtTotalGastos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="-$0.00"
                android:textAppearance="@style/TextAppearance.FinSell.Body"
                android:textStyle="bold"
                android:textColor="@color/colorError" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="@color/outline_variant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NETO"
                android:textAppearance="@style/TextAppearance.FinSell.Title" />

            <TextView
                android:id="@+id/txtTotalNeto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="$0.00"
                android:textAppearance="@style/TextAppearance.FinSell.Total"
                android:textStyle="bold"
                android:textColor="@color/pos_green" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtTotalVendidos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="end"
            android:text="0 vendidos"
            android:textAppearance="@style/TextAppearance.FinSell.Secondary" />
    </LinearLayout>

    <!-- Botones inferiores -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImprimir"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="🖨️ Imprimir"
            android:textColor="@color/text_secondary"
            app:strokeColor="@color/outline_variant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCerrar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Cerrar"
            app:backgroundTint="@color/pos_blue" />
    </LinearLayout>
</LinearLayout>