<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:orientation="horizontal"
    android:padding="8dp">

    <TextView android:id="@+id/tvNombre" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:text="Producto" android:textAppearance="@style/TextAppearance.FinSell.Body" />
    <TextView android:id="@+id/tvVendidos" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="0" android:textAppearance="@style/TextAppearance.FinSell.Secondary" />
    <TextView android:id="@+id/tvStock" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="0" android:textAppearance="@style/TextAppearance.FinSell.Secondary" />
    <TextView android:id="@+id/tvSubtotal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="$0.00" android:textAppearance="@style/TextAppearance.FinSell.Body" />
</LinearLayout>
