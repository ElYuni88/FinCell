<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Vista previa de la cámara -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Instrucciones en la parte superior -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/overlay_scrim"
        android:padding="16dp"
        android:text="Apunta al código de barras o QR"
        android:textColor="@android:color/white"
        android:textStyle="bold" />

    <!-- Botón de linterna (FAB) en la esquina inferior derecha -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabFlash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:src="@drawable/ic_flash_off"
        app:backgroundTint="@color/white"
        app:tint="@color/black"
        app:fabSize="normal" />

    <!-- Botón de cancelar en la parte inferior izquierda (o centrado) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:text="Cancelar"
        android:backgroundTint="@color/pos_red"
        android:textColor="@android:color/white" />

</FrameLayout>