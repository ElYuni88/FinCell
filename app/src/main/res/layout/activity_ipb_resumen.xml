<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/pos_green"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="IPB - Resumen del día"
        app:titleTextColor="@android:color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="8dp">

            <!-- Fecha -->
            <TextView
                android:id="@+id/txtFecha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fecha: --"
                android:textAppearance="@style/TextAppearance.FinSell.Title"
                android:textSize="18sp" />

            <!-- Tabla de productos -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Productos vendidos"
                android:textAppearance="@style/TextAppearance.FinSell.Title" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerIPB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false" />

            <!-- Separador visual -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/outline_variant" />

            <!-- Tabla de gastos -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gastos del día"
                android:textAppearance="@style/TextAppearance.FinSell.Title" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerGastos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false" />

            <!-- Totales -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Totales"
                    android:textAppearance="@style/TextAppearance.FinSell.Title" />

                <TextView
                    android:id="@+id/txtTotalVentas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="$0.00"
                    android:textAppearance="@style/TextAppearance.FinSell.Body" />

                <TextView
                    android:id="@+id/txtTotalGastos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="$0.00"
                    android:textAppearance="@style/TextAppearance.FinSell.Body" />

                <TextView
                    android:id="@+id/txtTotalNeto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="$0.00"
                    android:textAppearance="@style/TextAppearance.FinSell.Title"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Espacio extra al final para separar del borde -->
            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:visibility="invisible" />

        </LinearLayout>
    </ScrollView>

    <!-- Botones fijos en la parte inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnAjustarIPB"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Ajustar IPB"
            android:textColor="@color/pos_blue"
            app:strokeColor="@color/pos_blue" />

        <Button
            android:id="@+id/btnExportar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/pos_red"
            android:text="Exportar"
            android:textColor="@android:color/white" />
    </LinearLayout>
</LinearLayout>