<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/primary">

    <!-- ✅ CAMBIO 1: Icono de la app en lugar de "CP" -->
    <ImageView
        android:id="@+id/imgAppIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="Icono de la app"
        android:background="@drawable/bg_circle_green"
        android:padding="8dp"
        android:scaleType="fitCenter" />

    <!-- ✅ CAMBIO 2: Título con versión dinámica -->
    <TextView
        android:id="@+id/txtAppNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="CafePos"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/txtAppDescripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="APK de registros de ventas e inventarios"
        android:textColor="@color/brand_on_primary_soft"
        android:textSize="13sp" />

    <!-- ✅ CAMBIO 3: Punto de Venta dinámico -->
    <TextView
        android:id="@+id/txtPVLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="PV · Punto de Venta"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtPVNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sin asignación"
        android:textColor="@color/brand_on_primary_soft"
        android:textSize="13sp" />
</LinearLayout>
